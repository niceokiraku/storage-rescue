<Window x:Class="StorageRescue.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StorageRescue — 再接続対応 ddrescue 互換イメージャ" Width="1120" Height="860"
        MinWidth="900" MinHeight="700" FontSize="13" Background="#F4F5F7" Icon="app.ico">
    <Grid>
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="170"/>
            </Grid.RowDefinitions>

            <!-- 設定 -->
            <GroupBox Header="設定" Padding="8" x:Name="SettingsBox">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="入力ディスク" VerticalAlignment="Center"/>
                    <ComboBox x:Name="DiskCombo" Grid.Column="1" Height="26" SelectionChanged="OnSettingsChanged"/>
                    <Button Grid.Column="2" Content="一覧を更新" Click="OnRefreshDisks"/>

                    <TextBlock Grid.Row="1" Text="出力イメージ" VerticalAlignment="Center" Margin="0,6,0,0"/>
                    <TextBox x:Name="ImagePathBox" Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" TextChanged="OnImagePathChanged"/>
                    <Button Grid.Row="1" Grid.Column="2" Content="参照..." Margin="4,6,0,0" Click="OnBrowseImage"/>

                    <TextBlock Grid.Row="2" Text="mapfile" VerticalAlignment="Center" Margin="0,6,0,0"/>
                    <TextBox x:Name="MapPathBox" Grid.Row="2" Grid.Column="1" Margin="0,6,0,0" TextChanged="OnSettingsChanged"/>
                    <Button Grid.Row="2" Grid.Column="2" Content="参照..." Margin="4,6,0,0" Click="OnBrowseMap"/>

                    <TextBlock Grid.Row="3" Text="ddrescue" VerticalAlignment="Top" Margin="0,12,0,0"/>
                    <Grid Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,8,0,0">
                        <Grid.Resources>
                            <Style x:Key="Desc" TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#57606A"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="TextWrapping" Value="Wrap"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="0,0,16,0"/>
                            </Style>
                            <Style x:Key="Arg" TargetType="TextBlock">
                                <Setter Property="FontFamily" Value="Consolas"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </Grid.Resources>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" MinHeight="28"/>
                            <RowDefinition Height="Auto" MinHeight="28"/>
                            <RowDefinition Height="Auto" MinHeight="28"/>
                            <RowDefinition Height="Auto" MinHeight="28"/>
                        </Grid.RowDefinitions>

                        <!-- 左列：フェーズの ON/OFF -->
                        <CheckBox x:Name="DirectCheck" IsChecked="True" Click="OnSettingsChanged">
                            <TextBlock Text="-d (idirect)" Style="{StaticResource Arg}"/>
                        </CheckBox>
                        <TextBlock Grid.Column="1" Style="{StaticResource Desc}"
                                   Text="直接ディスクアクセス。OS のキャッシュを通さずに読み取ります（推奨）"/>

                        <CheckBox x:Name="NoTrimCheck" Grid.Row="1" Click="OnSettingsChanged">
                            <TextBlock Text="-N (no-trim)" Style="{StaticResource Arg}"/>
                        </CheckBox>
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Desc}"
                                   Text="トリミングを省略。読めなかったブロックの両端をセクタ単位で読み直す工程です"/>

                        <CheckBox x:Name="NoSweepCheck" Grid.Row="2" Click="OnSettingsChanged">
                            <TextBlock Text="--no-sweep" Style="{StaticResource Arg}"/>
                        </CheckBox>
                        <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Desc}"
                                   Text="スイープを省略。エラーで飛ばした領域を、飛ばさずに読み直す工程です"/>

                        <CheckBox x:Name="NoScrapeCheck" Grid.Row="3" Click="OnSettingsChanged">
                            <TextBlock Text="-n (no-scrape)" Style="{StaticResource Arg}"/>
                        </CheckBox>
                        <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Desc}"
                                   Text="スクレイピングを省略。残りをセクタ単位で読む最も時間のかかる工程です。まず読める所だけ救出したいときに"/>

                        <!-- 右列：数値の指定 -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <TextBlock Text="-r" Style="{StaticResource Arg}" Width="24"/>
                            <TextBox x:Name="RetryBox" Width="60" Text="0" TextChanged="OnSettingsChanged"/>
                            <TextBlock Text=" 回" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Grid.Column="3" Style="{StaticResource Desc}"
                                   Text="不良セクタを読み直す回数。0 なら読み直しません"/>

                        <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal">
                            <TextBlock Text="-c" Style="{StaticResource Arg}" Width="24"/>
                            <TextBox x:Name="ClusterBox" Width="60" Text="0" TextChanged="OnSettingsChanged"/>
                            <TextBlock Text=" セクタ" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Grid.Column="3" Style="{StaticResource Desc}"
                                   Text="一度に読み取るセクタ数。0 なら自動（64 KiB 分）"/>

                        <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal">
                            <TextBlock Text="-K" Style="{StaticResource Arg}" Width="24"/>
                            <TextBox x:Name="SkipBox" Width="140" Text="" TextChanged="OnSettingsChanged"/>
                        </StackPanel>
                        <TextBlock Grid.Row="2" Grid.Column="3" Grid.RowSpan="2" Style="{StaticResource Desc}" VerticalAlignment="Top" Margin="0,6,16,0"
                                   Text="読み取りに失敗したとき先へ飛ばす量を「初期値,最大値」で指定。連続して失敗するたびに倍増します。空なら自動（例: 64Ki,1Gi）"/>
                    </Grid>

                    <TextBlock Grid.Row="4" Text="再接続" VerticalAlignment="Center" Margin="0,8,0,0"/>
                    <WrapPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,8,0,0">
                        <TextBlock Text="読み取りタイムアウト(秒)" VerticalAlignment="Center"/>
                        <TextBox x:Name="TimeoutBox" Width="40" Text="10" Margin="4,0,14,0"/>
                        <TextBlock Text="電源OFF後の待ち(秒)" VerticalAlignment="Center"/>
                        <TextBox x:Name="OffWaitBox" Width="40" Text="10" Margin="4,0,14,0"/>
                        <TextBlock Text="スピンアップ待ち(秒)" VerticalAlignment="Center"/>
                        <TextBox x:Name="SpinUpBox" Width="40" Text="15" Margin="4,0,14,0"/>
                        <CheckBox x:Name="OfflineCheck" Content="開始時にオフライン＋読み取り専用化（再接続後も維持）" IsChecked="True"
                                  ToolTip="Windows がボリュームをマウント（ドライブ文字の割り当て・ファイルシステムへのアクセス）しないようにします。"/>
                    </WrapPanel>
                </Grid>
            </GroupBox>

            <!-- コマンド・操作 -->
            <DockPanel Grid.Row="1" Margin="0,8,0,0" LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="OfflineButton" Content="選択ディスクをオフライン化"
                            ToolTip="入力ディスクを永続的にオフライン＋読み取り専用にします。再接続してもマウントされなくなります。" Click="OnSetOffline"/>
                    <Button x:Name="OnlineButton" Content="オンラインに戻す"
                            ToolTip="入力ディスクをオンライン＋書き込み可能に戻します（作業終了後に使用）。" Click="OnSetOnline"/>
                    <Button x:Name="StartButton" Content="▶ 開始 / 再開" FontWeight="Bold" Margin="16,0,0,0" Click="OnStart"/>
                    <Button x:Name="StopButton" Content="■ 停止" IsEnabled="False" Click="OnStop"/>
                </StackPanel>
                <Border Background="#1E1E1E" CornerRadius="3" Padding="8,5">
                    <TextBlock x:Name="CommandText" Foreground="#9CDCFE" FontFamily="Consolas" TextTrimming="CharacterEllipsis"
                               ToolTip="参考：同等の GNU ddrescue コマンド（Linux）"/>
                </Border>
            </DockPanel>

            <!-- ステータス -->
            <Border Grid.Row="2" Margin="0,8,0,0" Background="#1E1E1E" CornerRadius="3" Padding="10,8">
                <StackPanel>
                    <TextBlock x:Name="PhaseText" Foreground="#DCDCAA" FontFamily="Consolas" FontSize="14" Text="待機中"/>
                    <TextBlock x:Name="StatusText" Foreground="#D4D4D4" FontFamily="Consolas" FontSize="13" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- セクタマップ -->
            <DockPanel Grid.Row="3" Margin="0,8,0,0">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="セクタマップ" FontWeight="Bold" Margin="0,0,16,0"/>
                    <Rectangle Width="12" Height="12" Fill="#3FB950"/><TextBlock Text=" finished (+)" Margin="0,0,12,0"/>
                    <Rectangle Width="12" Height="12" Fill="#6E7681"/><TextBlock Text=" non-tried (?)" Margin="0,0,12,0"/>
                    <Rectangle Width="12" Height="12" Fill="#D29922"/><TextBlock Text=" non-trimmed (*)" Margin="0,0,12,0"/>
                    <Rectangle Width="12" Height="12" Fill="#58A6FF"/><TextBlock Text=" non-scraped (/)" Margin="0,0,12,0"/>
                    <Rectangle Width="12" Height="12" Fill="#F85149"/><TextBlock Text=" bad-sector (-)" Margin="0,0,12,0"/>
                    <Rectangle Width="12" Height="12" Fill="White" Stroke="Black"/><TextBlock Text=" 現在位置"/>
                </StackPanel>
                <Border Background="#0D1117" CornerRadius="3" x:Name="MapHost" SizeChanged="OnMapHostSizeChanged">
                    <Image x:Name="MapImage" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                </Border>
            </DockPanel>

            <!-- ログ -->
            <ListBox x:Name="LogList" Grid.Row="4" Margin="0,8,0,0" FontFamily="Consolas" FontSize="12"/>
        </Grid>

        <!-- 電源入れ直し案内オーバーレイ -->
        <Grid x:Name="Overlay" Background="#B0000000" Visibility="Collapsed">
            <Border Background="White" CornerRadius="8" Padding="32,26" Width="640" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="OverlayStep" Foreground="#6E7681" FontSize="13"/>
                    <TextBlock x:Name="OverlayTitle" FontSize="28" FontWeight="Bold" TextWrapping="Wrap" Margin="0,4,0,12"/>
                    <TextBlock x:Name="OverlayMessage" FontSize="15" TextWrapping="Wrap" LineHeight="22"/>
                    <TextBlock x:Name="OverlayCountdown" FontSize="56" FontWeight="Bold" Foreground="#0969DA"
                               HorizontalAlignment="Center" Margin="0,12,0,0" Visibility="Collapsed"/>
                    <Border Background="#FFF8C5" BorderBrush="#D4A72C" BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,18,0,0">
                        <TextBlock TextWrapping="Wrap" FontSize="13">
                            <Run FontWeight="Bold">注意：</Run>再接続時に「ドライブ ○: を使うにはフォーマットする必要があります」と表示されても、<Run FontWeight="Bold">絶対にフォーマットしないでください</Run>（「キャンセル」を押してください）。保存先のディスクは抜かないでください。
                        </TextBlock>
                    </Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                        <Button x:Name="ConfirmOffButton" Content="電源を切りました" Padding="16,6" Click="OnConfirmPowerOff"/>
                        <Button Content="停止する" Padding="16,6" Margin="8,0,0,0" Click="OnStop"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
